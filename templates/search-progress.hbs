<div class='token-replacer-fa-search-progress'>
  <p class='search-progress-header'>
    <i class='fas fa-search fa-spin' aria-hidden='true'></i>
    <span>{{headerLabel}}</span>
  </p>
  <div class='search-progress-bar-container'>
    <div class='search-progress-info'>
      <span class='search-term'>{{searchingTermLabel}} <strong>{{term}}</strong></span>
      <span class='search-percent'>{{percent}}%</span>
    </div>
    <div
      class='search-progress-bar'
      role='progressbar'
      aria-valuemin='0'
      aria-valuemax='100'
      aria-valuenow='{{percent}}'
      aria-valuetext='{{termsProgressLabel}}'
    >
      <div class='search-progress-fill' style='width: {{percent}}%'></div>
    </div>
    <div class='search-progress-stats'>
      <span>{{termsProgressLabel}}</span>
      <span>{{resultsFoundLabel}}</span>
    </div>
  </div>
</div>