<div class='token-replacer-fa-scan-progress'>
  <p class='scan-status' data-announce>
    <i class='fas fa-search fa-spin' aria-hidden='true'></i>
    <span>{{scanningLabel}}</span>
  </p>

  <div class='scan-stats'>
    <div class='stat-item'>
      <div class='stat-value'>{{dirsScanned}}</div>
      <div class='stat-label'>{{directoriesLabel}}</div>
    </div>
    <div class='stat-item'>
      <div class='stat-value'>{{imagesFound}}</div>
      <div class='stat-label'>{{imagesFoundLabel}}</div>
    </div>
  </div>

  <div class='scan-current'>
    <div class='current-label'>{{currentDirectoryLabel}}</div>
    <div class='current-path' title='{{currentDir}}'>{{shortDir}}</div>
    {{#if currentFile}}
      <div class='current-file'>
        <i class='fas fa-image' aria-hidden='true'></i>
        {{currentFile}}
      </div>
    {{/if}}
  </div>

  {{#if showDirInfo}}
    <div class='dir-info'>
      <span><i class='fas fa-file-image' aria-hidden='true'></i> {{filesLabel}}</span>
      <span><i class='fas fa-folder' aria-hidden='true'></i> {{subdirectoriesLabel}}</span>
    </div>
  {{/if}}

  <div class='token-replacer-fa-progress-buttons'>
    <button
      type='button'
      class='cancel-btn'
      data-action='cancel'
      data-busy-label='{{cancellingLabel}}'
    >
      <i class='fas fa-times' aria-hidden='true'></i>
      <span class='btn-label'>{{cancelLabel}}</span>
    </button>
  </div>
</div>