<div class='token-replacer-fa-scan-progress'>
  {{#if refreshing}}
    <div class='scan-status'>
      <i class='fas fa-sync fa-spin'></i>
      <span>{{refreshingLabel}}</span>
    </div>
    <p style='text-align: center; color: #888; margin-top: 10px;'>
      {{refreshingHintLabel}}
    </p>
  {{else}}
    <div class='scan-status'>
      <i class='fas fa-bolt'></i>
      <span>{{statusMessage}}</span>
    </div>
    <div class='optimization-info'>
      <i class='fas fa-info-circle'></i>
      <span>{{tvaCacheInfoLabel}}</span>
    </div>
  {{/if}}

  <div class='token-replacer-fa-progress-buttons'>
    <button type='button' class='cancel-btn' data-action='cancel'>
      <i class='fas fa-times'></i>
      {{cancelLabel}}
    </button>
  </div>
</div>