<div class='token-replacer-fa-progress'>
  <div
    class='progress-bar'
    role='progressbar'
    aria-valuemin='0'
    aria-valuemax='100'
    aria-valuenow='{{percent}}'
    aria-valuetext='{{progressLabel}}'
  >
    <div class='progress-fill' style='width: {{percent}}%'></div>
  </div>
  <div class='progress-text' data-announce>{{progressLabel}}</div>
</div>

<div class='token-replacer-fa-summary'>
  <div class='summary-item success'>
    <div class='count'>{{successCount}}</div>
    <div class='label'>{{replacedLabel}}</div>
  </div>
  <div class='summary-item failed'>
    <div class='count'>{{failedCount}}</div>
    <div class='label'>{{failedLabel}}</div>
  </div>
  <div class='summary-item skipped'>
    <div class='count'>{{skippedCount}}</div>
    <div class='label'>{{skippedLabel}}</div>
  </div>
</div>

{{#if hasResults}}
  <ul class='token-replacer-fa-results'>
    {{#each results}}
      <li class='result-item {{this.status}}'>
        <span class='result-icon {{this.status}}' aria-hidden='true'>
          <i class='fas {{this.iconClass}}'></i>
        </span>
        <span class='result-name'>{{this.name}}</span>
        {{#if this.match}}
          <span class='result-match' title='{{this.match}}'>{{this.match}}</span>
        {{/if}}
      </li>
    {{/each}}
  </ul>
{{/if}}

{{#if isComplete}}
  <div class='token-replacer-fa-progress-buttons'>
    <button type='button' class='close-btn' data-action='close'>
      <i class='fas fa-check' aria-hidden='true'></i>
      <span class='btn-label'>{{closeLabel}}</span>
    </button>
  </div>
{{/if}}