<div class='token-replacer-fa-error {{toneClass}}' role='{{role}}'>
  <p class='error-status' data-announce>
    {{#if isInfo}}
      <i class='fas fa-info-circle' aria-hidden='true'></i>
    {{else}}
      <i class='fas fa-exclamation-triangle' aria-hidden='true'></i>
    {{/if}}
    <span>{{message}}</span>
  </p>

  {{#if recoverySuggestions}}
    <div class='error-recovery'>
      <p class='recovery-title'>
        <i class='fas fa-lightbulb' aria-hidden='true'></i>
        <span>{{howToFixLabel}}</span>
      </p>
      <ul class='recovery-suggestions'>
        {{#each recoverySuggestions}}
          <li>{{this}}</li>
        {{/each}}
      </ul>
    </div>
  {{/if}}

  {{#if details}}
    <details class='error-details'>
      <summary>{{showDetailsLabel}}</summary>
      <pre>{{details}}</pre>
    </details>
  {{/if}}
</div>

<div class='token-replacer-fa-progress-buttons'>
  <button type='button' class='close-btn' data-action='close'>
    <i class='fas fa-check' aria-hidden='true'></i>
    <span class='btn-label'>{{closeLabel}}</span>
  </button>
</div>