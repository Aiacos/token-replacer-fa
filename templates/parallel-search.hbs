<div class='token-replacer-fa-scan-progress'>
  <p class='scan-status'>
    <i class='fas fa-bolt' aria-hidden='true'></i>
    <span>{{titleLabel}}</span>
  </p>

  <div class='scan-stats'>
    <div class='stat-item'>
      <div class='stat-value'>{{uniqueTypes}}</div>
      <div class='stat-label'>{{uniqueCreaturesLabel}}</div>
    </div>
    <div class='stat-item'>
      <div class='stat-value'>{{totalTokens}}</div>
      <div class='stat-label'>{{totalTokensLabel}}</div>
    </div>
  </div>

  <div class='token-replacer-fa-progress'>
    <div
      class='progress-bar'
      role='progressbar'
      aria-valuemin='0'
      aria-valuemax='100'
      aria-valuenow='{{percent}}'
      aria-valuetext='{{progressLabel}}'
    >
      <div class='progress-fill' style='width: {{percent}}%'></div>
    </div>
    <div class='progress-text' data-announce>{{progressLabel}}</div>
  </div>

  {{#if hasBatch}}
    <div class='scan-current'>
      <div class='current-label'>{{currentlySearchingLabel}}</div>
      <ul class='parallel-batch'>
        {{#each currentBatch}}
          <li class='batch-item'>
            <i class='fas fa-search fa-spin' aria-hidden='true'></i>
            {{this}}
          </li>
        {{/each}}
      </ul>
    </div>
  {{/if}}

  <p class='optimization-info'>
    <i class='fas fa-info-circle' aria-hidden='true'></i>
    <span>{{sharedResultsLabel}}</span>
  </p>

  <div class='token-replacer-fa-progress-buttons'>
    <button
      type='button'
      class='cancel-btn'
      data-action='cancel'
      data-busy-label='{{cancellingLabel}}'
    >
      <i class='fas fa-times' aria-hidden='true'></i>
      <span class='btn-label'>{{cancelLabel}}</span>
    </button>
  </div>
</div>